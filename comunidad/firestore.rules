rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedVerified() { return request.auth != null && request.auth.token.email_verified == true; }
    function verified() { return signedVerified() && (!exists(/databases/$(database)/documents/members/$(request.auth.uid)) || get(/databases/$(database)/documents/members/$(request.auth.uid)).data.get('blocked',false) == false); }
    function owner() { return signedVerified() && request.auth.token.email == 'pepedm83@gmail.com'; }
    function admin(group) { return owner() || (verified() && exists(/databases/$(database)/documents/grants/$(request.auth.uid)) && (get(/databases/$(database)/documents/grants/$(request.auth.uid)).data.get('role', 'group') == 'community' || group in get(/databases/$(database)/documents/grants/$(request.auth.uid)).data.groups)); }
    function communityAdmin() { return owner() || (verified() && exists(/databases/$(database)/documents/grants/$(request.auth.uid)) && get(/databases/$(database)/documents/grants/$(request.auth.uid)).data.get('role','group') == 'community'); }
    match /members/{uid} {
      allow read: if signedVerified() && (request.auth.uid == uid || communityAdmin());
      allow create, update: if owner() && request.auth.uid != uid && request.resource.data.keys().hasOnly(['blocked']) && request.resource.data.blocked is bool;
      allow delete: if false;
    }
    match /profiles/{uid} {
      allow read: if verified() && (request.auth.uid == uid || communityAdmin());
      allow create, update: if verified() && request.auth.uid == uid && request.resource.data.keys().hasOnly(['name','lastSeen']) && (!('lastSeen' in request.resource.data) || request.resource.data.lastSeen == request.time || (exists(/databases/$(database)/documents/profiles/$(uid)) && request.resource.data.lastSeen == resource.data.get('lastSeen',null))) && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80;
      allow delete: if verified() && request.auth.uid == uid;
    }
    match /groups/{id} {
      allow read: if true;
      allow write: if owner() && request.resource.data.keys().hasOnly(['name','whatsapp']) && request.resource.data.name is string && request.resource.data.whatsapp is string && (request.resource.data.whatsapp == '' || request.resource.data.whatsapp.matches('https://chat[.]whatsapp[.]com/.*'));
    }
    match /grants/{uid} {
      allow read: if verified() && (request.auth.uid == uid || owner());
      allow create, update: if owner() && request.resource.data.keys().hasOnly(['groups','role']) && request.resource.data.groups is list && request.resource.data.get('role', 'group') in ['group','community'];
      allow delete: if owner();
    }
    match /requests/{uid} {
      allow read: if verified() && (request.auth.uid == uid || owner());
      allow create, update: if verified() && request.auth.uid == uid && request.resource.data.keys().hasOnly(['name','group']) && request.resource.data.name is string && request.resource.data.name.size() <= 80 && request.resource.data.group is string && exists(/databases/$(database)/documents/groups/$(request.resource.data.group));
      allow delete: if owner() || (verified() && request.auth.uid == uid);
    }
    match /events/{id} {
      allow read: if true;
      function https(value) { return value is string && (value == '' || value.matches('https://.*')); }
      function validEvent() {
        let d = request.resource.data;
        return d.keys().hasOnly(['title','category','group','start','location','description','ticket','meal','createdBy','locationURL','mealTime','restaurantURL','activityDeposit','mealDeposit','bizumInstructions','cancelled'])
          && d.get('cancelled',false) is bool
          && d.title is string && d.title.size() > 0 && d.title.size() <= 150
          && d.category in ['route','concert','meetup','palau','bowling','moto','culture','wine','travel','cinema','padel','dance']
          && d.start is string && d.location is string && d.description is string && d.description.size() <= 5000
          && https(d.ticket) && https(d.get('locationURL','')) && https(d.get('restaurantURL',''))
          && d.meal is string && d.meal.size() <= 300 && d.get('mealTime','') is string
          && d.get('bizumInstructions','') is string && d.get('bizumInstructions','').size() <= 500
          && d.get('activityDeposit',0) is number && d.get('activityDeposit',0) >= 0 && d.get('activityDeposit',0) <= 10000
          && d.get('mealDeposit',0) is number && d.get('mealDeposit',0) >= 0 && d.get('mealDeposit',0) <= 10000
          && (d.meal != '' || (d.get('mealDeposit',0) == 0 && d.get('restaurantURL','') == '' && d.get('mealTime','') == ''))
          && exists(/databases/$(database)/documents/groups/$(d.group));
      }
      allow create: if admin(request.resource.data.group) && validEvent() && request.resource.data.createdBy == request.auth.uid;
      // Editing is restricted to admins of both the previous and selected groups.
      allow update: if admin(resource.data.group) && admin(request.resource.data.group) && validEvent() && request.resource.data.createdBy == resource.data.createdBy;
      // The app cancels by setting cancelled=true, preserving registrations and history.
      allow delete: if admin(resource.data.group);
      match /attendees/{uid} {
        function unpaid() { return !exists(/databases/$(database)/documents/events/$(id)/payments/$(uid)) || (get(/databases/$(database)/documents/events/$(id)/payments/$(uid)).data.get('activity','pending') == 'pending' && get(/databases/$(database)/documents/events/$(id)/payments/$(uid)).data.get('meal','pending') == 'pending'); }
        allow read: if verified() && exists(/databases/$(database)/documents/events/$(id));
allow create, update: if unpaid() && verified() && request.auth.uid == uid && exists(/databases/$(database)/documents/events/$(id)) && request.resource.data.keys().hasOnly(['name','companions','mealPeople']) && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80 && request.resource.data.companions is int && request.resource.data.companions >= 0 && request.resource.data.companions <= 10 && request.resource.data.mealPeople is int && request.resource.data.mealPeople >= 0 && request.resource.data.mealPeople <= request.resource.data.companions + 1 && (request.resource.data.mealPeople == 0 || get(/databases/$(database)/documents/events/$(id)).data.meal != '');
        allow delete: if verified() && request.auth.uid == uid && unpaid();
      }
      match /checkins/{uid} {
        allow read: if verified() && exists(/databases/$(database)/documents/events/$(id)) && (request.auth.uid == uid || admin(get(/databases/$(database)/documents/events/$(id)).data.group));
        allow create, update: if admin(get(/databases/$(database)/documents/events/$(id)).data.group) && exists(/databases/$(database)/documents/events/$(id)/attendees/$(uid)) && request.resource.data.keys().hasOnly(['present']) && request.resource.data.present is bool;
        allow delete: if false;
      }
      match /payments/{uid} {
        function eventAdmin() { return admin(get(/databases/$(database)/documents/events/$(id)).data.group); }
        function eligible(kind) {
          let e = get(/databases/$(database)/documents/events/$(id)).data;
          let a = get(/databases/$(database)/documents/events/$(id)/attendees/$(uid)).data;
          return kind == 'activity' ? e.get('activityDeposit',0) > 0 : e.get('mealDeposit',0) > 0 && a.mealPeople > 0;
        }
        function userChange(kind) {
          return request.resource.data.get(kind,'pending') == resource.data.get(kind,'pending') ||
            (eligible(kind) && request.resource.data.get(kind,'pending') == 'reported' && resource.data.get(kind,'pending') != 'confirmed');
        }
        allow read: if verified() && exists(/databases/$(database)/documents/events/$(id)) && (request.auth.uid == uid || eventAdmin());
        allow create: if verified() && exists(/databases/$(database)/documents/events/$(id)/attendees/$(uid))
          && request.resource.data.keys().hasOnly(['activity','meal'])
          && request.resource.data.get('activity','pending') in ['pending','reported','confirmed']
          && request.resource.data.get('meal','pending') in ['pending','reported','confirmed']
          && (eventAdmin() || (request.auth.uid == uid
            && request.resource.data.get('activity','pending') in ['pending','reported']
            && request.resource.data.get('meal','pending') in ['pending','reported']
            && (request.resource.data.get('activity','pending') == 'pending' || eligible('activity'))
            && (request.resource.data.get('meal','pending') == 'pending' || eligible('meal'))));
        allow update: if verified() && exists(/databases/$(database)/documents/events/$(id)/attendees/$(uid))
          && request.resource.data.keys().hasOnly(['activity','meal'])
          && request.resource.data.get('activity','pending') in ['pending','reported','confirmed']
          && request.resource.data.get('meal','pending') in ['pending','reported','confirmed']
          && (eventAdmin() || (request.auth.uid == uid && userChange('activity') && userChange('meal')));
      }
    }
  }
}
