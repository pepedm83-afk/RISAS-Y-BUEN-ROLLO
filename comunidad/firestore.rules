rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function signedVerified() { return signedIn() && request.auth.token.email_verified == true; }
    function emailVerified() { return request.auth != null && request.auth.token.email_verified == true; }
    function verified() { return signedVerified() && (!exists(/databases/$(database)/documents/members/$(request.auth.uid)) || get(/databases/$(database)/documents/members/$(request.auth.uid)).data.get('blocked',false) == false); }
    function participant() {
      return verified() && (owner() || noticeSender() || (
        exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
        && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.get('phone','') != ''
        && ((exists(/databases/$(database)/documents/membershipReviews/$(request.auth.uid))
          && get(/databases/$(database)/documents/membershipReviews/$(request.auth.uid)).data.active == true
          && get(/databases/$(database)/documents/membershipReviews/$(request.auth.uid)).data.phone == get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.phone)
          || exists(/databases/$(database)/documents/grants/$(request.auth.uid)))));
    }
    match /membershipReviews/{uid} {
      allow read: if verified() && (request.auth.uid == uid || communityAdmin());
      allow create, update: if communityAdmin()
        && request.resource.data.keys().hasOnly(['active','phone','reviewedAt','reviewedBy'])
        && request.resource.data.active is bool && request.resource.data.phone is string
        && request.resource.data.phone == get(/databases/$(database)/documents/profiles/$(uid)).data.phone
        && request.resource.data.phone.matches('[+][1-9][0-9]{7,14}')
        && request.resource.data.reviewedAt == request.time && request.resource.data.reviewedBy == request.auth.uid;
      allow delete: if false;
    }
    function feedbackSeat(eventId,uid) {
      let path = /databases/$(database)/documents/events/$(eventId);
      let seat = get(/databases/$(database)/documents/events/$(eventId)/feedbackEligibility/$(uid)).data;
      let revision = exists(/databases/$(database)/documents/events/$(eventId)/attendanceState/current) ? get(/databases/$(database)/documents/events/$(eventId)/attendanceState/current).data.revision : 0;
      return seat.admitted == true && seat.revision == revision && seat.endAt == get(path).data.endAt
        && (!exists(/databases/$(database)/documents/events/$(eventId)/checkins/$(uid)) || get(/databases/$(database)/documents/events/$(eventId)/checkins/$(uid)).data.present != false);
    }
    // Feedback is identified for community admins and never visible to other members.
    match /eventFeedback/{feedbackId} {
      allow read: if communityAdmin();
      allow create: if participant()
        && request.resource.data.keys().hasOnly(['eventId','uid','overall','organization','venue','price','incident','comment','createdAt']) && request.resource.data.uid == request.auth.uid
        && request.resource.data.eventId is string
        && request.resource.data.overall in ['Excelente','Bien','Regular','Mal']
        && request.resource.data.organization in ['Excelente','Bien','Regular','Mal']
        && request.resource.data.venue in ['','Excelente','Bien','Regular','Mal']
        && request.resource.data.price in ['Adecuado','Caro','No corresponde']
        && request.resource.data.incident is bool
        && request.resource.data.comment is string && request.resource.data.comment.size() <= 1500
        && request.resource.data.createdAt == request.time
        && get(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data.get('endAt',4102444800000) <= request.time.toMillis()
        && request.time.toMillis() < get(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data.endAt + 604800000
        && !get(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data.get('cancelled',false)
        && feedbackSeat(request.resource.data.eventId,request.auth.uid)
        && getAfter(/databases/$(database)/documents/events/$(request.resource.data.eventId)/feedbackReceipts/$(request.auth.uid)).data.feedbackId == feedbackId;
      allow update, delete: if false;
    }
    function owner() { return emailVerified() && request.auth.token.email == 'pepedm83@gmail.com'; }
    function noticeSender() { return verified() && emailVerified() && request.auth.token.email == 'peperisasybuenrollo@gmail.com'; }
    function admin(group) { return owner() || (verified() && emailVerified() && exists(/databases/$(database)/documents/grants/$(request.auth.uid)) && (get(/databases/$(database)/documents/grants/$(request.auth.uid)).data.get('role', 'group') == 'community' || group in get(/databases/$(database)/documents/grants/$(request.auth.uid)).data.groups)); }
    function communityAdmin() { return owner() || (verified() && emailVerified() && exists(/databases/$(database)/documents/grants/$(request.auth.uid)) && get(/databases/$(database)/documents/grants/$(request.auth.uid)).data.get('role','group') == 'community'); }
    function managesEvent(id) { let e = get(/databases/$(database)/documents/events/$(id)).data; return participant() && (e.createdBy == request.auth.uid || admin(e.group)); }
    match /members/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || communityAdmin() || noticeSender());
      allow create, update: if owner() && request.auth.uid != uid && request.resource.data.keys().hasOnly(['blocked']) && request.resource.data.blocked is bool;
      allow delete: if false;
    }
    match /profiles/{uid} {
      allow read: if verified() && (request.auth.uid == uid || communityAdmin());
      allow create, update: if verified() && request.auth.uid == uid && request.resource.data.keys().hasOnly(['name','nameKey','lastSeen','phone','phoneCountry']) && (!('phone' in request.resource.data) || (request.resource.data.phone is string && request.resource.data.phone.matches('[+][1-9][0-9]{7,14}') && request.resource.data.phoneCountry is string && request.resource.data.phoneCountry.matches('[+][1-9][0-9]{0,2}'))) && (!('lastSeen' in request.resource.data) || request.resource.data.lastSeen == request.time || (exists(/databases/$(database)/documents/profiles/$(uid)) && request.resource.data.lastSeen == resource.data.get('lastSeen',null))) && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80 && ((exists(/databases/$(database)/documents/profiles/$(uid)) && request.resource.data.name == resource.data.name && request.resource.data.get('nameKey','') == resource.data.get('nameKey','')) || (request.resource.data.nameKey is string && request.resource.data.nameKey.size() > 0 && getAfter(/databases/$(database)/documents/nameClaims/$(request.resource.data.nameKey)).data.uid == uid));
      allow delete: if verified() && request.auth.uid == uid;
    }
    // One private registration notice per verified account, addressed only to the owner mailbox.
    match /registrationNotices/{uid} {
      allow read: if owner() || noticeSender() || (verified() && request.auth.uid == uid);
      allow create: if verified() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name','email','createdAt','status'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.email is string && request.resource.data.email.size() <= 254
        && request.resource.data.name == get(/databases/$(database)/documents/profiles/$(uid)).data.name
        && request.resource.data.createdAt == request.time && request.resource.data.status == 'pending';
      allow update: if noticeSender()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','lastError','lastAttemptAt','completedAt'])
        && request.resource.data.status in ['pending','sent','skipped','needsReview'];
      allow delete: if false;
    }
    match /phoneNotices/{uid} {
      allow read: if verified() && (request.auth.uid == uid || communityAdmin() || noticeSender());
      allow create, update: if verified() && (request.auth.uid == uid || communityAdmin())
        && request.resource.data.keys().hasOnly(['uid','name','phone','createdAt','status'])
        && request.resource.data.uid == uid && request.resource.data.status == 'pending'
        && request.resource.data.name == getAfter(/databases/$(database)/documents/profiles/$(uid)).data.name
        && request.resource.data.phone == getAfter(/databases/$(database)/documents/profiles/$(uid)).data.phone
        && request.resource.data.phone.matches('[+][1-9][0-9]{7,14}')
        && request.resource.data.createdAt == request.time
        && (!exists(/databases/$(database)/documents/phoneNotices/$(uid)) || resource.data.phone != request.resource.data.phone);
      allow update: if noticeSender()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','lastError','lastAttemptAt','completedAt'])
        && request.resource.data.status in ['pending','sent','skipped','needsReview'];
      allow delete: if false;
    }
    match /nameClaims/{key} {
      allow read: if verified();
      // Pepe can reserve the names of existing members without changing their profiles.
      allow create: if owner() || (verified() && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == request.auth.uid && getAfter(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.nameKey == key);
      allow update: if false;
      allow delete: if verified() && resource.data.uid == request.auth.uid && getAfter(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.get('nameKey','') != key;
    }
    match /settings/{id} {
      allow read: if id == 'community';
      allow create, update: if id == 'community' && communityAdmin()
        && request.resource.data.keys().hasOnly(['announcementGroupURL'])
        && request.resource.data.announcementGroupURL is string
        && request.resource.data.announcementGroupURL.matches('https://chat[.]whatsapp[.]com/.*');
      allow delete: if false;
    }
    match /groups/{id} {
      allow read: if true;
      allow create, update: if communityAdmin() && request.resource.data.keys().hasOnly(['name','whatsapp']) && request.resource.data.name is string && request.resource.data.whatsapp is string && (request.resource.data.whatsapp == '' || request.resource.data.whatsapp.matches('https://chat[.]whatsapp[.]com/.*'));
    }
    match /grants/{uid} {
      allow read: if verified() && (request.auth.uid == uid || communityAdmin() || noticeSender());
      allow create, update: if owner() && request.resource.data.keys().hasOnly(['groups','role']) && request.resource.data.groups is list && request.resource.data.get('role', 'group') in ['group','community'];
      // Community admins assign groups only to existing admins. Only Pepe changes roles or authorizes new admins.
      allow update: if communityAdmin() && request.resource.data.keys().hasOnly(['groups','role']) && request.resource.data.groups is list && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['groups']) && request.resource.data.get('role','group') == resource.data.get('role','group');
      allow delete: if owner();
    }
    // Email addresses are private; only each admin, Pepe and the dedicated sender can read them.
    match /notificationContacts/{uid} {
      allow read: if owner() || (verified() && request.auth.uid == uid) || (noticeSender() && exists(/databases/$(database)/documents/grants/$(uid)));
      allow create, update: if (owner() || (verified() && emailVerified() && request.auth.uid == uid && request.resource.data.email == request.auth.token.email)) && request.resource.data.keys().hasOnly(['email']) && request.resource.data.email is string && request.resource.data.email.size() > 3 && request.resource.data.email.size() <= 254;
      allow delete: if owner();
    }
    match /emailSubscriptions/{uid} {
      allow read: if noticeSender() || (verified() && request.auth.uid == uid);
      allow create, update: if verified() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email','enabled','groups','updatedAt'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.enabled is bool
        && (!request.resource.data.enabled || (emailVerified() && request.auth.token.email != 'pepedm83@gmail.com'))
        && request.resource.data.groups is list && request.resource.data.groups.size() <= 100
        && request.resource.data.groups.toSet().size() == request.resource.data.groups.size()
        && (!request.resource.data.enabled || request.resource.data.groups.size() > 0)
        && request.resource.data.updatedAt == request.time;
      allow delete: if verified() && request.auth.uid == uid;
    }
    // Device tokens are private: never visible to other members or administrators.
    match /pushDevices/{id} {
      allow read: if noticeSender() || (verified() && (!exists(/databases/$(database)/documents/pushDevices/$(id)) || resource.data.uid == request.auth.uid));
      allow create, update: if verified() && request.resource.data.uid == request.auth.uid
        && (!exists(/databases/$(database)/documents/pushDevices/$(id)) || resource.data.uid == request.auth.uid)
        && request.resource.data.keys().hasOnly(['uid','token','enabled','groups','subscribedAt','updatedAt'])
        && request.resource.data.token is string && request.resource.data.token.size() > 20 && request.resource.data.token.size() <= 4096
        && request.resource.data.enabled is bool && request.resource.data.groups is list
        && request.resource.data.groups.size() > 0 && request.resource.data.groups.size() <= 100
        && request.resource.data.groups.toSet().size() == request.resource.data.groups.size()
        && request.resource.data.updatedAt == request.time
        && (request.resource.data.subscribedAt == request.time || (exists(/databases/$(database)/documents/pushDevices/$(id))
          && request.resource.data.subscribedAt == resource.data.subscribedAt
          && request.resource.data.groups == resource.data.groups && resource.data.enabled && request.resource.data.enabled));
      allow update: if noticeSender() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['enabled','updatedAt'])
        && request.resource.data.enabled == false && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedAt >= resource.data.updatedAt && request.resource.data.updatedAt <= request.time;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
    match /notificationQueue/{id} {
      function assignedCreator() {
        return emailVerified() && exists(/databases/$(database)/documents/grants/$(request.auth.uid))
          && (get(/databases/$(database)/documents/grants/$(request.auth.uid)).data.get('role','group') == 'community'
          || (emailVerified() && exists(/databases/$(database)/documents/grants/$(request.auth.uid))
          && get(/databases/$(database)/documents/grants/$(request.auth.uid)).data.get('groups',[]).size() > 0));
      }
      function adminCreator() { return owner() || assignedCreator(); }
      // Every new event queues a notice. The sender resolves recipients from actual roles, never client-selected mailboxes.
      allow create: if verified() && request.resource.data.keys().hasOnly(['eventId','createdBy','creatorName','notifyAdmins','creatorIsAdmin','createdAt','status','pushStatus'])
        && (!('pushStatus' in request.resource.data) || request.resource.data.pushStatus == 'pending')
        && request.resource.data.notifyAdmins is bool
        && (!('creatorIsAdmin' in request.resource.data) || request.resource.data.creatorIsAdmin == adminCreator())
        && request.resource.data.eventId == id && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.creatorName == get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.name
        && request.resource.data.createdAt == request.time && request.resource.data.status == 'pending'
        && !exists(/databases/$(database)/documents/events/$(id))
        && getAfter(/databases/$(database)/documents/events/$(id)).data.createdBy == request.auth.uid;
      allow read: if owner() || noticeSender();
      allow update: if noticeSender() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','deliveredTo','lastError','lastAttemptAt','completedAt','pushStatus','pushDeliveredTo','pushLastError','pushLastAttemptAt','pushCompletedAt'])
        && request.resource.data.status in ['pending','waitingContacts','sent','skipped','needsReview']
        && request.resource.data.get('pushStatus','pending') in ['pending','sent','skipped'];
      allow delete: if false;
    }
    match /requests/{uid} {
      allow read: if verified() && (request.auth.uid == uid || owner());
      allow create, update: if verified() && request.auth.uid == uid && emailVerified() && request.resource.data.keys().hasOnly(['name','group','groups']) && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80 && ((request.resource.data.get('groups',[]) is list && request.resource.data.get('groups',[]).size() > 0 && request.resource.data.groups.size() <= 30 && request.resource.data.groups.toSet().size() == request.resource.data.groups.size()) || (request.resource.data.get('group','') is string && exists(/databases/$(database)/documents/groups/$(request.resource.data.group))));
      allow delete: if owner() || (verified() && request.auth.uid == uid);
    }
    match /events/{id} {
      allow read: if true;
      function https(value) { return value is string && (value == '' || value.matches('https://.*')); }
      function validMealOption(menu,i) { return menu.size() <= i || (menu[i] is string && menu[i].size() > 0 && menu[i].size() <= 60); }
      function validEvent() {
        let d = request.resource.data;
        return d.keys().hasOnly(['title','category','group','start','location','description','ticket','meal','createdBy','locationURL','mealTime','restaurantURL','activityDeposit','mealDeposit','bizumInstructions','cancelled','mealMenu','mealCloseAt','capacity','endAt'])
          && d.get('endAt',0) is int && d.get('endAt',0) >= 0 && d.get('endAt',0) <= 4102444800000
          && d.get('cancelled',false) is bool && d.get('capacity',0) is int && d.get('capacity',0) >= 0 && d.get('capacity',0) <= 1000
          && d.get('mealMenu',[]) is list && d.get('mealMenu',[]).size() <= 6
          && d.get('mealMenu',[]).toSet().size() == d.get('mealMenu',[]).size()
          && validMealOption(d.get('mealMenu',[]),0) && validMealOption(d.get('mealMenu',[]),1)
          && validMealOption(d.get('mealMenu',[]),2) && validMealOption(d.get('mealMenu',[]),3)
          && validMealOption(d.get('mealMenu',[]),4) && validMealOption(d.get('mealMenu',[]),5)
          && d.get('mealCloseAt',0) is int && d.get('mealCloseAt',0) >= 0 && d.get('mealCloseAt',0) <= 4102444800000
          && (d.get('mealMenu',[]).size() == 0 || d.meal != '')
          && (d.get('mealCloseAt',0) == 0 || d.get('mealMenu',[]).size() > 0)
          && d.title is string && d.title.size() > 0 && d.title.size() <= 150
          && d.category in ['route','concert','meetup','palau','bowling','moto','culture','wine','travel','cinema','padel','dance']
          && d.start is string && d.location is string && d.description is string && d.description.size() <= 5000
          && https(d.ticket) && https(d.get('locationURL','')) && https(d.get('restaurantURL',''))
          && d.meal is string && d.meal.size() <= 300 && d.get('mealTime','') is string
          && d.get('bizumInstructions','') is string && d.get('bizumInstructions','').size() <= 500
          && d.get('activityDeposit',0) is number && d.get('activityDeposit',0) >= 0 && d.get('activityDeposit',0) <= 10000
          && d.get('mealDeposit',0) is number && d.get('mealDeposit',0) >= 0 && d.get('mealDeposit',0) <= 10000
          && (d.meal != '' || (d.get('mealDeposit',0) == 0 && d.get('restaurantURL','') == '' && d.get('mealTime','') == ''))
          && exists(/databases/$(database)/documents/groups/$(d.group));
      }
      allow create: if participant() && validEvent() && request.resource.data.createdBy == request.auth.uid;
      // Creators manage their own events; group admins may move events only between their groups.
      allow update: if participant() && (resource.data.createdBy == request.auth.uid || (admin(resource.data.group) && admin(request.resource.data.group))) && validEvent() && request.resource.data.createdBy == resource.data.createdBy && (request.resource.data.get('capacity',0) == resource.data.get('capacity',0) || capacityMovement());
      // The app cancels by setting cancelled=true, preserving registrations and history.
      allow delete: if admin(resource.data.group);
      function latestMovement() {
        let state = getAfter(/databases/$(database)/documents/events/$(id)/attendanceState/current).data;
        return getAfter(/databases/$(database)/documents/events/$(id)/attendanceChanges/$(state.lastChange)).data;
      }
      function movementFor(uid,kind,people) {
        let op = latestMovement();
        return op.actor == request.auth.uid && op.uid == uid && op.kind == kind && op.people == people && op.createdAt == request.time;
      }
      function capacityMovement() { return movementFor(request.auth.uid,'capacity',0); }
      match /feedbackReceipts/{uid} {
        allow read: if verified() && request.auth.uid == uid;
        allow create: if participant() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['feedbackId','createdAt'])
          && request.resource.data.feedbackId is string && request.resource.data.createdAt == request.time
          && !exists(/databases/$(database)/documents/eventFeedback/$(request.resource.data.feedbackId))
          && getAfter(/databases/$(database)/documents/eventFeedback/$(request.resource.data.feedbackId)).data.eventId == id
          && getAfter(/databases/$(database)/documents/eventFeedback/$(request.resource.data.feedbackId)).data.createdAt == request.time
          && getAfter(/databases/$(database)/documents/eventFeedback/$(request.resource.data.feedbackId)).data.uid == uid;
        allow update, delete: if false;
      }
      match /feedbackEligibility/{uid} {
        allow read: if participant() && (request.auth.uid == uid || noticeSender());
        allow create, update: if noticeSender()
          && request.resource.data.keys().hasOnly(['admitted','revision','endAt'])
          && request.resource.data.admitted == true && request.resource.data.revision is int && request.resource.data.endAt is int;
        allow delete: if false;
      }
      match /feedbackEligibilityState/{key} {
        allow read, create, update: if noticeSender() && key == 'current';
        allow delete: if false;
      }
      match /attendanceState/{stateId} {
        allow read: if participant() && exists(/databases/$(database)/documents/events/$(id));
        function validState() {
          let d = request.resource.data;
          let op = getAfter(/databases/$(database)/documents/events/$(id)/attendanceChanges/$(d.lastChange)).data;
          return stateId == 'current' && d.keys().hasOnly(['revision','lastChange','updatedAt'])
            && d.revision is int && d.lastChange is string && d.lastChange.size() > 0
            && d.updatedAt == request.time && op.seq == d.revision && op.actor == request.auth.uid && op.createdAt == request.time;
        }
        allow create: if participant() && validState() && request.resource.data.revision == 1;
        allow update: if participant() && validState() && request.resource.data.revision == resource.data.revision + 1;
        allow delete: if false;
      }
      match /attendanceChanges/{changeId} {
        allow read: if participant() && exists(/databases/$(database)/documents/events/$(id));
        function validMovement() {
          let d = request.resource.data;
          let before = get(/databases/$(database)/documents/events/$(id)).data;
          let after = getAfter(/databases/$(database)/documents/events/$(id)).data;
          let state = getAfter(/databases/$(database)/documents/events/$(id)/attendanceState/current).data;
          return d.keys().hasOnly(['seq','actor','uid','kind','people','legacyPeople','limitBefore','limitAfter','createdAt'])
            && d.seq is int && d.seq > 0 && state.revision == d.seq && state.lastChange == changeId
            && d.actor == request.auth.uid && d.uid == request.auth.uid && d.createdAt == request.time
            && d.people is int && d.legacyPeople is int && d.legacyPeople >= 0 && d.legacyPeople <= 11
            && d.limitBefore == before.get('capacity',0) && d.limitAfter == after.get('capacity',0)
            && (d.kind == 'capacity' ? (managesEvent(id) && d.people == 0 && d.legacyPeople == 0 && d.limitBefore != d.limitAfter) : validPartyMovement(d));
        }
        function validPartyMovement(d) {
          let path = /databases/$(database)/documents/events/$(id)/attendees/$(d.uid);
          let present = exists(path);
          let legacy = present && get(path).data.get('joinedOrder',0) == 0;
          return d.limitBefore == d.limitAfter
            && d.legacyPeople == (legacy ? get(path).data.companions + 1 : 0)
            && (d.kind == 'leave' ? (present && !existsAfter(path) && d.people == 0)
              : (d.kind in ['join','change'] && (d.kind == 'join' ? !present : present)
              && existsAfter(path) && d.people == getAfter(path).data.companions + 1 && d.people >= 1 && d.people <= 11));
        }
        allow create: if participant() && validMovement();
        allow update, delete: if false;
      }
      match /attendees/{uid} {
        function validAttendanceOrder(uid) {
          let d = request.resource.data;
          let present = exists(/databases/$(database)/documents/events/$(id)/attendees/$(uid));
          let op = latestMovement();
          return (present
            ? (d.get('joinedOrder',0) == resource.data.get('joinedOrder',0) && d.get('joinedAt',null) == resource.data.get('joinedAt',null) && movementFor(uid,'change',d.companions+1))
            : (d.joinedAt == request.time && d.joinedOrder == op.seq && movementFor(uid,'join',d.companions+1)));
        }
        function unpaid() { return !exists(/databases/$(database)/documents/events/$(id)/payments/$(uid)) || (get(/databases/$(database)/documents/events/$(id)/payments/$(uid)).data.get('activity','pending') == 'pending' && get(/databases/$(database)/documents/events/$(id)/payments/$(uid)).data.get('meal','pending') == 'pending'); }
        allow read: if participant() && exists(/databases/$(database)/documents/events/$(id));
allow create, update: if validAttendanceOrder(uid) && unpaid() && participant() && request.auth.uid == uid && exists(/databases/$(database)/documents/events/$(id)) && request.resource.data.keys().hasOnly(['name','companions','mealPeople','joinedOrder','joinedAt']) && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80 && request.resource.data.companions is int && request.resource.data.companions >= 0 && request.resource.data.companions <= 10 && request.resource.data.mealPeople is int && request.resource.data.mealPeople >= 0 && request.resource.data.mealPeople <= request.resource.data.companions + 1 && (request.resource.data.mealPeople == 0 || get(/databases/$(database)/documents/events/$(id)).data.meal != '');
        allow delete: if participant() && request.auth.uid == uid && unpaid() && movementFor(uid,'leave',0);
      }
      // Plate choices are independent of payments; members change only their own reservation.
      match /mealSelections/{uid} {
        function event() { return get(/databases/$(database)/documents/events/$(id)).data; }
        function validChoices() {
          let e = event();
          let a = getAfter(/databases/$(database)/documents/events/$(id)/attendees/$(uid)).data;
          let d = request.resource.data;
          return !e.get('cancelled',false) && e.get('mealMenu',[]).size() > 0
            && d.keys().hasOnly(['choices','updatedAt']) && d.choices is list
            && d.choices.size() == a.mealPeople && d.choices.size() <= 11
            && d.choices.toSet().hasOnly(e.mealMenu.toSet().union([''].toSet()))
            && d.updatedAt == request.time;
        }
        allow read: if participant() && exists(/databases/$(database)/documents/events/$(id));
        allow create, update: if participant() && (request.auth.uid == uid || managesEvent(id))
          && validChoices()
          && (managesEvent(id) || event().get('mealCloseAt',0) == 0 || request.time.toMillis() <= event().mealCloseAt);
        allow delete: if participant() && request.auth.uid == uid && !existsAfter(/databases/$(database)/documents/events/$(id)/attendees/$(uid));
      }
      match /checkins/{uid} {
        allow read: if participant() && exists(/databases/$(database)/documents/events/$(id)) && (request.auth.uid == uid || managesEvent(id));
        allow create, update: if managesEvent(id) && exists(/databases/$(database)/documents/events/$(id)/attendees/$(uid)) && request.resource.data.keys().hasOnly(['present']) && request.resource.data.present is bool;
        allow delete: if false;
      }
      match /payments/{uid} {
        function eventAdmin() { return managesEvent(id); }
        function eligible(kind) {
          let e = get(/databases/$(database)/documents/events/$(id)).data;
          let a = get(/databases/$(database)/documents/events/$(id)/attendees/$(uid)).data;
          return kind == 'activity' ? e.get('activityDeposit',0) > 0 : e.get('mealDeposit',0) > 0 && a.mealPeople > 0;
        }
        function userChange(kind) {
          return request.resource.data.get(kind,'pending') == resource.data.get(kind,'pending') ||
            (eligible(kind) && request.resource.data.get(kind,'pending') == 'reported' && resource.data.get(kind,'pending') != 'confirmed');
        }
        allow read: if participant() && exists(/databases/$(database)/documents/events/$(id)) && (request.auth.uid == uid || eventAdmin());
        allow create: if participant() && exists(/databases/$(database)/documents/events/$(id)/attendees/$(uid))
          && request.resource.data.keys().hasOnly(['activity','meal'])
          && request.resource.data.get('activity','pending') in ['pending','reported','confirmed']
          && request.resource.data.get('meal','pending') in ['pending','reported','confirmed']
          && (eventAdmin() || (request.auth.uid == uid
            && request.resource.data.get('activity','pending') in ['pending','reported']
            && request.resource.data.get('meal','pending') in ['pending','reported']
            && (request.resource.data.get('activity','pending') == 'pending' || eligible('activity'))
            && (request.resource.data.get('meal','pending') == 'pending' || eligible('meal'))));
        allow update: if participant() && exists(/databases/$(database)/documents/events/$(id)/attendees/$(uid))
          && request.resource.data.keys().hasOnly(['activity','meal'])
          && request.resource.data.get('activity','pending') in ['pending','reported','confirmed']
          && request.resource.data.get('meal','pending') in ['pending','reported','confirmed']
          && (eventAdmin() || (request.auth.uid == uid && userChange('activity') && userChange('meal')));
      }
    }
  }
}


